<resources>
    <!-- Base application theme -->
    <style name="Theme.EterniaAI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryVariant">@color/tertiary_variant</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <!-- Background colors -->
        <item name="colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <!-- Outline colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <!-- Scrim -->
        <item name="colorScrim">@color/scrim</item>
        <!-- Shadow -->
        <item name="colorShadow">@color/shadow</item>
        <!-- Inverse colors -->
        <item name="colorInverseSurface">@color/inverse_surface</item>
        <item name="colorInverseOnSurface">@color/inverse_on_surface</item>
        <item name="colorInversePrimary">@color/inverse_primary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Ripple -->
        <item name="colorControlHighlight">@color/ripple_color</item>
        <!-- Text appearance -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Eternia.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Eternia.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Eternia.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Eternia.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Eternia.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Eternia.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Eternia.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Eternia.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Eternia.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Eternia.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Eternia.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Eternia.LabelSmall</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.EterniaAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.EterniaAI</item>
    </style>

    <!-- Text Appearance Styles -->
    <style name="TextAppearance.Eternia.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/serif_font</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontWeight">700</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Eternia.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/serif_font</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Eternia.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/serif_font</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Eternia.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Eternia.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Eternia.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Eternia.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="TextAppearance.Eternia.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.025</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="TextAppearance.Eternia.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.Eternia.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Eternia.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.Eternia.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/sans_font</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Component Styles -->
    <style name="Widget.Eternia.Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Eternia.LabelLarge</item>
    </style>

    <style name="Widget.Eternia.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Eternia.LabelLarge</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.Eternia.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Eternia.LabelLarge</item>
    </style>

    <style name="Widget.Eternia.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline_variant</item>
    </style>

    <style name="Widget.Eternia.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <style name="Widget.Eternia.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="cornerRadius">12dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextAppearance">@style/TextAppearance.Eternia.BodyMedium</item>
        <item name="placeholderTextAppearance">@style/TextAppearance.Eternia.BodyMedium</item>
        <item name="errorTextAppearance">@style/TextAppearance.Eternia.BodySmall</item>
        <item name="counterTextAppearance">@style/TextAppearance.Eternia.LabelSmall</item>
    </style>

    <style name="Widget.Eternia.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipHeight">36dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Eternia.LabelMedium</item>
    </style>

    <style name="Widget.Eternia.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Eternia.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemIconPadding">16dp</item>
        <item name="itemTextAppearance">@style/TextAppearance.Eternia.BodyMedium</item>
    </style>

    <!-- Dialog Styles -->
    <style name="Theme.EterniaAI.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="windowMinWidthMajor">90%</item>
        <item name="windowMinWidthMinor">90%</item>
    </style>

    <style name="Theme.EterniaAI.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Eternia.BottomSheet</item>
    </style>

    <style name="Widget.Eternia.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eternia.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Eternia.BottomSheet" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
</resources>